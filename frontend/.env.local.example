# Frontend env (Next.js loads this at build/dev time)
# Copy to .env.local for local development.

# Public — exposed to the browser via Next.js.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# OTel browser exporter endpoint (set when running with collector locally).
NEXT_PUBLIC_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces

# Server-side only (used by the agent-proxy route handler).
# Same value as NEXT_PUBLIC_BACKEND_URL when running outside Docker.
BACKEND_URL=http://localhost:8000

# Internal agent identifier registered with the CopilotKit runtime.
# Exposed as NEXT_PUBLIC_ so the client `useCoAgent` hook agrees with the
# server `<CopilotKit agent=...>` provider.
COPILOTKIT_AGENT_NAME=kloc_agent
NEXT_PUBLIC_COPILOTKIT_AGENT_NAME=kloc_agent
