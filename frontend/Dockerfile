# syntax=docker/dockerfile:1.6
#
# Multi-stage build → standalone Next.js output.
#
# Stage 1 (deps):  install npm deps in a clean image.
# Stage 2 (build): copy source + run `next build` (writes .next/standalone).
# Stage 3 (run):   minimal runtime with the standalone bundle + static
#                  assets + public/ files.

FROM node:22-alpine AS deps
WORKDIR /app
# Use package.json + lockfile (when present) for reproducible installs.
COPY package.json package-lock.json* ./
# `npm ci` requires a lockfile; fall back to `install` when running off
# the bare manifest (first build before the lockfile is committed).
RUN if [ -f package-lock.json ]; then npm ci; else npm install --no-audit --no-fund; fi

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Run as non-root.
RUN addgroup -S kloc && adduser -S kloc -G kloc
USER kloc

# Standalone output bundles only what the server needs.
COPY --from=build --chown=kloc:kloc /app/.next/standalone ./
COPY --from=build --chown=kloc:kloc /app/.next/static ./.next/static
COPY --from=build --chown=kloc:kloc /app/public ./public

EXPOSE 3000

# server.js is generated by Next.js standalone output.
CMD ["node", "server.js"]
