# =========================================================================
# kloc-agent .env example
# Owner: dev-1 (backend). dev-2 / dev-3 send change-requests to add entries.
# =========================================================================

# --- Backend (dev-1) ---
DATABASE_URL=postgresql+asyncpg://kloc:changeme@postgres:5432/kloc_agent
POSTGRES_USER=kloc
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kloc_agent

# MinIO / S3-compatible artifact store
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
ARTIFACT_BUCKET=kloc-agent-artifacts-dev

# Runner config (consumed by RunnerRegistry + WarmIdleManager; values applied
# in dev-2's Phase 2.D but the env vars are read by dev-1's Settings).
RUNNER_WARM_IDLE_S=60
RUNNER_HEARTBEAT_TIMEOUT_S=30
RUNNER_IMAGE_TAG=kloc-agent-runner:dev

# LLM provider switch (consumed by runner/model_factory.py inside the runner
# container; surfaced in backend settings so we can validate at boot).
# Operator pivot: `gemini` is the default; `anthropic` stays wired.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...
# Optional override for self-hosted / proxy Anthropic gateways. Empty means
# the runner uses the SDK default endpoint. B-INFRA-9: forwarded by compose
# into the backend env and then by docker_runner.py into each runner.
ANTHROPIC_BASE_URL=

# Service URLs
BACKEND_URL=http://backend:8000
# Streamable-HTTP MCP URL for kloc-intelligence. The kloc-intelligence
# stack (Neo4j + Qdrant + `kloc-intelligence mcp-server-http`) runs on
# the operator host independently of kloc-agent. Runner containers reach
# it via Docker's `host.docker.internal` alias (extra_hosts in compose).
KLOC_MCP_URL=http://host.docker.internal:8765/mcp

# HMAC webhook secret shared with runners (per-runner key derived at spawn).
# This is the boot-time bootstrap secret; per-runner secrets are minted in
# RunnerRegistry.get_or_spawn().
KLOC_HOOK_SECRET=change-me-32-bytes-random-base64

# Test-deny toggle for QA scenario 10 / AC19. Comma-separated tool names.
# Empty (default) means allow-all.
KLOC_DENY_TOOLS=

# --- Runner env (dev-2) ---
# Compose's default network name when project is named `kloc-agent`. Runners
# are attached to this network so they can reach `backend:8000` for the
# JSONL channel and HMAC webhook.
KLOC_DOCKER_NETWORK=kloc-agent_default
# Host path bind-mounted READ-ONLY into runner containers at /skills.
# Relative to repo root; aiodocker resolves to absolute at spawn.
KLOC_SKILLS_DIR_HOST=./skills
# B-INFRA-1: spawn mode. `docker` (default) requires aiodocker +
# /var/run/docker.sock bind-mounted into the backend container. Set to
# `stub` to skip DockerRunner construction entirely (CI, local dev
# without Docker). Real PoC traffic requires `docker`.
KLOC_RUNNER_MODE=docker

# --- Frontend (dev-3) ---
# Exposed to the browser; values must be safe to ship in the JS bundle.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# --- OTel (Track H, dev-3) ---
# Backend + runner containers are wrapped with `opentelemetry-instrument`;
# console exporter is on for dev parity, OTLP for collector.
OTEL_SERVICE_NAME=kloc-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_EXPORTER=otlp,console
OTEL_METRICS_EXPORTER=otlp,console
