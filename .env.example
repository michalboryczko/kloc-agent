# =========================================================================
# kloc-agent — single source of truth for environment configuration.
#
# - Loaded automatically by `docker compose up` (compose picks up `.env`
#   from the project root with no `env_file:` directive needed).
# - For local non-Docker dev: copy this file to `.env`, edit, and either
#   `source` it (Python) or run `dotenv -e ../.env -- next dev` (frontend).
# - SECRETS: never commit real values. Either leave blank here and `export`
#   them in your shell (compose interpolates from shell env), or use a
#   gitignored `.env` that is NOT checked in.
# =========================================================================

# ---------------------------------------------------------------------------
# Database (backend)
# ---------------------------------------------------------------------------
POSTGRES_USER=kloc
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kloc_agent
DATABASE_URL=postgresql+asyncpg://kloc:changeme@postgres:5432/kloc_agent

# ---------------------------------------------------------------------------
# Artifact storage (MinIO / S3) — backend
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
ARTIFACT_BUCKET=kloc-agent-artifacts-dev

# ---------------------------------------------------------------------------
# Runner lifecycle (backend reads these; values are plumbed into each
# per-session runner container at spawn).
# ---------------------------------------------------------------------------
RUNNER_WARM_IDLE_S=300
RUNNER_HEARTBEAT_TIMEOUT_S=30
RUNNER_IMAGE_TAG=kloc-agent-runner:dev
KLOC_DOCKER_NETWORK=kloc
KLOC_SKILLS_DIR_HOST=./skills

# ---------------------------------------------------------------------------
# LLM provider (backend validates at boot; runner reads at turn time)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
# Leave empty to use the default `gemini-3.1-pro-preview`.
LLM_MODEL_ID=
# Secret — DO NOT put a real key here. Export it in your shell:
#   export GEMINI_API_KEY=...
# docker-compose interpolates ${GEMINI_API_KEY:-} from the shell env, so
# leaving it blank in .env still works as long as the shell exports it.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Service URLs
# ---------------------------------------------------------------------------
# Compose-internal URL the runner uses to reach the backend (and the
# frontend's server-side routes use to call the backend API).
BACKEND_URL=http://backend:8000
# Streamable-HTTP MCP endpoint (kloc-intelligence runs as a separate stack
# on the operator host; runners reach it via Docker's host-gateway alias).
KLOC_MCP_URL=http://host.docker.internal:8765/mcp

# ---------------------------------------------------------------------------
# Security — backend
# ---------------------------------------------------------------------------
# HMAC bootstrap secret. Per-runner secrets are minted at spawn time;
# this is only the boot-time fallback. Rotate before any non-local use.
# Same rule as API keys: prefer shell export over committing real values.
KLOC_HOOK_SECRET=
# Comma-separated tool names to deny. Empty = allow-all.
KLOC_DENY_TOOLS=
# Comma-separated CORS origins allowed by the FastAPI backend.
KLOC_CORS_ALLOW_ORIGINS=http://localhost:3000
# When true, accept the bootstrap HMAC secret for unknown runner_ids.
# Test / stub use only. Refuses to boot with the default KLOC_HOOK_SECRET.
ALLOW_HMAC_FALLBACK=false
# Skip provider-key validation at boot. Test / CI only.
KLOC_STUB_MODE=false
# Per-frame stderr diagnostic emitters in the JSONL ingress / HMAC receiver.
KLOC_DIAG_EVENTS=false

# ---------------------------------------------------------------------------
# OpenTelemetry — backend + runner (forwarded from backend env at spawn).
# Both processes are wrapped with `opentelemetry-instrument`.
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=kloc-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=console
OTEL_METRICS_EXPORTER=console
OTEL_LOGS_EXPORTER=console

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the client bundle at `next build` —
# must also be passed as a build ARG by docker-compose. Browser-visible
# host-mapped backend URL (the backend container port is published to
# host port 8002 in docker-compose.yml).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8002
NEXT_TELEMETRY_DISABLED=1
